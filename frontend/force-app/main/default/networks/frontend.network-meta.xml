    <!-- Zwei Gruppen, beide noetig.

         Systemadministrator: ohne ein internes Profil als Mitglied verliert der
         Administrator die Zugehoerigkeit. Folge war eine tote Zeile in All
         Sites: keine URL, "Erweitert" nicht klickbar, Experience Builder nicht
         erreichbar. Bei 10 von 11 Sites dieser Org war Samuel Mitglied, nur bei
         dieser nicht - genau die Zeile war tot.

         Customer Community Plus User: nimmt kuenftig Portalnutzer automatisch
         auf. Die Gruppe allein genuegt aber nicht, sie muss um das interne
         Profil ergaenzt werden.

         Hinweis: bestehende Gruppen kann ein Metadata-Deploy nicht entfernen
         (nicht deletable), und ein frischer Insert via Apex scheitert an
         "DML operation Update not allowed". Netzwerk-Mitgliedschaft laesst sich
         deshalb nur per REST-API/Data Loader setzen, nicht aus dem Deployment
         heraus. Beide Zeilen wurden per REST eingefuegt und sind hier nur
         dokumentiert, damit der Zustand nachvollziehbar bleibt. -->
    <networkMemberGroups>
        <profile>Admin</profile>
        <profile>Customer Community Plus User</profile>
    </networkMemberGroups>
    <networkPageOverrides>
        <changePasswordPageOverrideSetting>Standard</changePasswordPageOverrideSetting>
        <forgotPasswordPageOverrideSetting>Designer</forgotPasswordPageOverrideSetting>
        <homePageOverrideSetting>Designer</homePageOverrideSetting>
        <loginPageOverrideSetting>Designer</loginPageOverrideSetting>
        <selfRegProfilePageOverrideSetting>Designer</selfRegProfilePageOverrideSetting>
    </networkPageOverrides>
    <secondaryEmailSenderEnabled>false</secondaryEmailSenderEnabled>
    <selfRegistration>false</selfRegistration>
    <sendWelcomeEmail>true</sendWelcomeEmail>
    <site>frontend</site>
    <siteArchiveStatus>NotArchived</siteArchiveStatus>
    <status>Live</status>
    <tabs>
