    <headlessRegistrationTemplate>unfiled$public/CommunityHeadlessRegistrationTemplate</headlessRegistrationTemplate>
    <!-- KEINE networkMemberGroups.
         Eine explizite Gruppe auf ein externes Profil nimmt dem internen
         Administrator die implizite Site-Mitgliedschaft: die URL der Site
         verschwindet aus All Sites, "Erweitert" laesst sich nicht oeffnen und
         der Experience Builder ist unerreichbar. Genau das ist mit diesem
         Netzwerk passiert, seit die Gruppe gesetzt wurde.

         NetworkMember ist per Metadata API nicht anlegbar (create=False), die
         Mitgliedschaft kann also nur in Setup gepflegt werden. Ohne Gruppe
         gilt wieder die implizite Mitgliedschaft, der Builder ist erreichbar
         und Portalnutzer werden ueber Setup einzeln eingetragen. -->
    <networkPageOverrides>
        <changePasswordPageOverrideSetting>Standard</changePasswordPageOverrideSetting>
        <forgotPasswordPageOverrideSetting>Designer</forgotPasswordPageOverrideSetting>
        <homePageOverrideSetting>Designer</homePageOverrideSetting>
        <loginPageOverrideSetting>Designer</loginPageOverrideSetting>
        <selfRegProfilePageOverrideSetting>Designer</selfRegProfilePageOverrideSetting>
    </networkPageOverrides>
    <secondaryEmailSenderEnabled>false</secondaryEmailSenderEnabled>
    <selfRegistration>false</selfRegistration>
    <sendWelcomeEmail>true</sendWelcomeEmail>
    <site>frontend</site>
    <siteArchiveStatus>NotArchived</siteArchiveStatus>
    <status>Live</status>
    <tabs>
        <defaultTab>home</defaultTab>
        <standardTab>Chatter</standardTab>
    </tabs>
    <urlPathPrefix>organisatorvforcesite</urlPathPrefix>
    <welcomeTemplate>unfiled$public/CommunityWelcomeEmailTemplate</welcomeTemplate>
</Network>
