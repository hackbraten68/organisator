# List files or directories below to ignore them when running force:source:push, force:source:pull, and force:source:status
# More information: https://developer.salesforce.com/docs/atlas.en-us.sfdx_dev.meta/sfdx_dev/sfdx_dev_exclude_source.htm
#

package.xml

# Never deploy a Profile. It cannot provision a required field; the deploy fails
# and rollbackOnError rolls back EVERY custom object with it (AGENTS.md E3).
# Real guard: backend/scripts/preflight-deploy.mjs --project <this dir>.
# Second layer only — these patterns are not a proven filter for
# `sf project deploy start` (measured with @salesforce/cli 2.149.9).
**/profiles/**
**/*.profile-meta.xml
**/sharingRules/**
**/*.sharingRules-meta.xml
**/sharingSets/**
**/*.sharingSet-meta.xml

# LWC configuration files
**/jsconfig.json
**/.eslintrc.json

# LWC Jest
**/__tests__/**

node_modules/
.DS_Store

# Playwright output. The bundle directory's own .gitignore already covers these,
# but `.gitignore` is not read by `sf project deploy start` — only .forceignore is.
# Measured: a run of `npx playwright test` left playwright-report/ and
# test-results/ on disk, and the next `sf project deploy start --metadata
# UIBundle:frontend` uploaded their .md and .zip payloads to the live portal.
# Nothing reads them there; they just sit in the bundle as dead weight that
# differs on every run.
**/playwright-report/**
**/test-results/**