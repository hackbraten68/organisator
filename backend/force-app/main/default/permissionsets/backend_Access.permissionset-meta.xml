<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>backend Access</label>
    <userPermissions>
        <enabled>true</enabled>
        <name>ApiEnabled</name>
    </userPermissions>

    <!--
        StaffIdentity is what lets the UI bundle learn who is signed in without
        asking (the runtime carries no user identity, see the class comment). Apex
        REST needs an explicit class grant: without this entry a limited internal
        profile gets 403 on /services/apexrest/staff-identity/me and the backoffice
        falls back to the actor picker.

        AppointmentEditService is the named server-side entry point for editing an
        appointment (ADR-014). Same rule: without this entry the route answers
        403 and nobody can edit a draft appointment.
    -->
    <classAccesses>
        <apexClass>StaffIdentity</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>AppointmentEditService</apexClass>
        <enabled>true</enabled>
    </classAccesses>
</PermissionSet>