<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Done_Requires_CompletedAt</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
  ISPICKVAL(Status__c, &quot;Done&quot;),
  ISBLANK(CompletedAt__c)
)</errorConditionFormula>
    <errorMessage>A completed task requires a completion timestamp.</errorMessage>
</ValidationRule>
