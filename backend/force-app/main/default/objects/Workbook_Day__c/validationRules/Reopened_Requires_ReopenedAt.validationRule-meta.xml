<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Reopened_Requires_ReopenedAt</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
  ISPICKVAL(Status__c, &quot;Reopened&quot;),
  ISBLANK(LastReopenedAt__c)
)</errorConditionFormula>
    <errorMessage>A reopened workbook day requires a last reopened timestamp.</errorMessage>
</ValidationRule>
