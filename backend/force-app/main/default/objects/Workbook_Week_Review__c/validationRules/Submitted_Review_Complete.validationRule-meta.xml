<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Submitted_Review_Complete</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
  ISPICKVAL(Status__c, &quot;Submitted&quot;),
  OR(
    ISBLANK(SubmittedAt__c),
    ISBLANK(SummarySnapshot__c)
  )
)</errorConditionFormula>
    <errorMessage>A submitted review requires a submission timestamp and a summary snapshot.</errorMessage>
</ValidationRule>
